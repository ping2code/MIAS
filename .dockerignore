# Build context for Containerfile (Phase 14B). The production stage copies an explicit package allowlist; tests stay in
# the context only for the validation target and never reach the runtime image.
.git
.gitignore
.venv
venv
**/__pycache__
**/*.py[cod]
.pytest_cache
.coverage
.env
*.env
**/.env
runtime
scripts
*.log
.idea
.vscode
.DS_Store
Thumbs.db
